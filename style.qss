/* SnP Image Labeler - theme TEMPLATE.
   Double-brace placeholders are resolved per mode by core/theme.py;
   every Npx is multiplied by the UI scale. Do not put raw hex
   colours in here - add a token in core/theme.py instead. */

/* ── Base ──────────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: {{bg}};
    color: {{text}};
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
    font-size: 16px;
}

/* -- Menu bar ---------------------------------------------------- */
/* Every command lives here, so it has to stay legible at any UI scale.
   Pop-up menus size themselves to their text and scroll when too tall,
   which is what keeps commands reachable when the toolbar cannot fit. */
QMenuBar#main_menubar {
    background-color: {{bg_alt}};
    color: {{text}};
    border-bottom: 1px solid {{border}};
    padding: 2px 4px;
    font-size: 14px;
}
QMenuBar#main_menubar::item {
    background: transparent;
    padding: 5px 11px;
    border-radius: 4px;
}
QMenuBar#main_menubar::item:selected { background: {{bg_hover}}; }
QMenuBar#main_menubar::item:pressed  { background: {{accent}}; color: {{text_on_accent}}; }

QMenu {
    background-color: {{bg_raised}};
    color: {{text}};
    border: 1px solid {{border_strong}};
    padding: 4px;
    font-size: 14px;
}
QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected  { background: {{accent}}; color: {{text_on_accent}}; }
QMenu::item:disabled  { color: {{text_faint}}; }
QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: 4px 8px;
}
QMenu::indicator {
    width: 13px;
    height: 13px;
    margin-left: 6px;
}
QMenu::indicator:checked {
    background: {{accent}};
    border: 1px solid {{accent}};
    border-radius: 3px;
}
QMenu::indicator:unchecked {
    border: 1px solid {{border_strong}};
    border-radius: 3px;
}
QMenu::right-arrow { width: 10px; height: 10px; margin-right: 6px; }

/* The overflow chevron is the only way to reach a toolbar button that no
   longer fits. Qt gives it a fixed 15px, which is an invisible sliver once
   the UI is scaled up, so it is sized here with everything else. */
QToolBarExtension {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    min-width: 22px;
    padding: 2px;
    qproperty-icon: none;
    qproperty-text: ">>";
    color: {{text}};
    font-size: 14px;
    font-weight: bold;
}
QToolBarExtension:hover { background: {{accent}}; color: {{text_on_accent}}; }

/* ── Toolbar ────────────────────────────────────────────────────── */
QToolBar#main_toolbar {
    background-color: {{bg_alt}};
    border-bottom: 1px solid {{border}};
    padding: 4px 6px;
    spacing: 2px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 9px;
    color: {{text}};
    font-size: 14px;
}
QToolButton:hover  { background: {{bg_hover}}; border-color: {{border_strong}}; }
QToolButton:pressed { background: {{bg_active}}; }

/* ── Panel headers ──────────────────────────────────────────────── */
QLabel#panel_header {
    background-color: {{bg_alt}};
    color: {{accent_text}};
    font-weight: 600;
    font-size: 16px;
    padding: 9px 8px;
    border-bottom: 1px solid {{border}};
}

/* ── Image Queue ────────────────────────────────────────────────── */
QLabel#count_label {
    background: {{bg_alt}};
    color: {{text_muted}};
    font-size: 14px;
    padding: 4px 6px;
    border-bottom: 1px solid {{border}};
}

QListWidget#image_list {
    background: {{bg_alt}};
    border: none;
    border-right: 1px solid {{border}};
    outline: none;
}
QListWidget#image_list::item {
    padding: 5px 4px;
    border-bottom: 1px solid {{border}};
}
QListWidget#image_list::item:selected {
    background: {{bg_select}};
    color: {{accent_text}};
}
QListWidget#image_list::item:hover:!selected {
    background: {{bg_raised}};
}

/* ── Info bar ───────────────────────────────────────────────────── */
QFrame#info_bar {
    background: {{bg_alt}};
    border-top: 1px solid {{border}};
}
QLabel#info_label {
    color: {{text_muted}};
    font-size: 14px;
}

/* ── Telemetry: field labels ─────────────────────────────────────── */
QLabel#field_label {
    color: {{accent_text}};
    font-weight: 600;
    font-size: 14px;
}
QLabel#empty_label {
    color: {{text_faint}};
    font-size: 14px;
    padding: 20px;
}
QFrame#field_sep { color: {{text_faint}}; }

/* ── Inputs ─────────────────────────────────────────────────────── */
QLineEdit {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 5px;
    padding: 5px 8px;
    color: {{text}};
    selection-background-color: {{accent}};
    selection-color: {{text_on_accent}};
}
QLineEdit:focus { border-color: {{accent}}; }

QComboBox {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 5px;
    padding: 5px 8px;
    color: {{text}};
}
QComboBox:focus  { border-color: {{accent}}; }
QComboBox::drop-down { border: none; padding-right: 6px; }
QComboBox::down-arrow { width: 10px; }
QComboBox QAbstractItemView {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    selection-background-color: {{bg_active}};
    color: {{text}};
}

QCheckBox, QRadioButton {
    color: {{text}};
    spacing: 6px;
    padding: 2px 0;
}
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 2px solid {{border_strong}};
    border-radius: 3px;
    background: {{bg_hover}};
}
QCheckBox::indicator:checked {
    border-color: {{accent}};
    background: {{accent}};
}
QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 2px solid {{border_strong}};
    border-radius: 8px;
    background: {{bg_hover}};
}
QRadioButton::indicator:checked {
    border-color: {{accent}};
    background: {{accent}};
}

QTextEdit {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 5px;
    padding: 5px;
    color: {{text}};
}
QTextEdit:focus { border-color: {{accent}}; }

/* ── Save label button ──────────────────────────────────────────── */
QFrame#save_frame {
    background: {{bg_alt}};
    border-top: 1px solid {{border}};
}
QPushButton#save_label_btn {
    background: {{accent}};
    color: {{text_on_accent}};
    border: none;
    border-radius: 7px;
    font-weight: 700;
    font-size: 16px;
    padding: 8px;
}
QPushButton#save_label_btn:hover   { background: {{accent_alt}}; }
QPushButton#save_label_btn:pressed { background: {{accent_hover}}; }
QPushButton#save_label_btn:disabled {
    background: {{bg_active}};
    color: {{text_faint}};
}

/* ── Generic buttons (dialogs) ──────────────────────────────────── */
QPushButton {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 5px;
    padding: 5px 14px;
    color: {{text}};
}
QPushButton:hover   { background: {{bg_active}}; }
QPushButton:pressed { background: {{border_muted}}; }
QPushButton:disabled { color: {{text_faint}}; }

/* ── Dialog list ────────────────────────────────────────────────── */
QListWidget {
    background: {{bg_hover}};
    border: 1px solid {{border_strong}};
    border-radius: 5px;
    color: {{text}};
    outline: none;
}
QListWidget::item:selected { background: {{bg_active}}; color: {{accent_text}}; }
QListWidget::item:hover:!selected { background: {{bg_active}}; }

/* ── Splitter ───────────────────────────────────────────────────── */
QSplitter::handle { background: {{bg_hover}}; }

/* ── Status bar ─────────────────────────────────────────────────── */
QStatusBar {
    background: {{bg_alt}};
    border-top: 1px solid {{border}};
    color: {{text_muted}};
    font-size: 14px;
}
QLabel#outdir_label {
    color: {{text_faint}};
    font-size: 14px;
    padding-right: 8px;
}

/* ── Scrollbars ─────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: {{bg_alt}};
    width: 8px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: {{bg_active}};
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: {{border_muted}}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: {{bg_alt}};
    height: 8px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: {{bg_active}};
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: {{border_muted}}; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Tooltip ────────────────────────────────────────────────────── */
QToolTip {
    background: {{bg_hover}};
    color: {{text}};
    border: 1px solid {{border_strong}};
    padding: 4px 8px;
    border-radius: 4px;
}

/* ── Message box ────────────────────────────────────────────────── */
QMessageBox {
    background: {{bg}};
}
QMessageBox QLabel { color: {{text}}; font-size: 15px; }

/* ── Annotation / BBox additions ────────────────────────────────── */

/* Queue header with inline Clear button */
QFrame#queue_header_frame {
    background: {{bg_alt}};
    border-bottom: 1px solid {{border}};
}
QLabel#panel_header_inline {
    color: {{accent_text}};
    font-weight: 600;
    font-size: 16px;
    padding: 2px 4px;
    background: transparent;
}
QPushButton#queue_clear_btn {
    background: {{bg_hover}};
    color: {{danger}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    font-size: 16px;
    padding: 2px 6px;
}
QPushButton#queue_clear_btn:hover   { background: {{bg_active}}; }
QPushButton#queue_clear_btn:disabled { color: {{text_faint}}; }

/* Annotations tab */
QListWidget#bbox_list {
    background: {{bg_alt}};
    border: none;
    outline: none;
    color: {{text}};
}
QListWidget#bbox_list::item {
    padding: 5px 6px;
    border-bottom: 1px solid {{border}};
    font-size: 16px;
}
QListWidget#bbox_list::item:selected {
    background: {{bg_select}};
    color: {{accent_text}};
}

/* Mode label in info bar */
QLabel#mode_label {
    color: {{text_muted}};
    font-size: 16px;
    font-weight: 600;
    padding: 0 6px;
}

/* Right tab widget */
QTabWidget#right_tabs::pane {
    border: none;
    background: {{bg}};
}
QTabBar::tab {
    background: {{bg_alt}};
    color: {{text_muted}};
    border: 1px solid {{border}};
    border-bottom: none;
    padding: 5px 14px;
    font-size: 16px;
}
QTabBar::tab:selected {
    background: {{bg}};
    color: {{accent_text}};
    font-weight: 600;
}
QTabBar::tab:hover:!selected { background: {{bg_raised}}; }

/* ── Checkable toolbar buttons (Navigate / Annotate mode) ───────── */
QToolButton:checked {
    background: {{accent}};
    color: {{text_on_accent}};
    border: 1px solid {{accent_alt}};
    border-radius: 5px;
    font-weight: 700;
}
QToolButton:checked:hover {
    background: {{accent_alt}};
}

/* ── Toast notification ─────────────────────────────────────────── */
QLabel#toast_label {
    background: rgba(30, 30, 46, 220);
    color: {{danger}};
    border: 1px solid {{danger}};
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 18px;
}

/* ── Segregation task additions ─────────────────────────────────── */

/* Count bar row (holds the count label + Pending filter) */
QFrame#count_frame {
    background: {{bg_alt}};
    border-bottom: 1px solid {{border}};
}
QPushButton#queue_filter_btn {
    background: {{bg_hover}};
    color: {{text_muted}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    font-size: 14px;
    padding: 1px 4px;
}
QPushButton#queue_filter_btn:hover   { background: {{bg_active}}; }
QPushButton#queue_filter_btn:checked {
    background: {{accent}};
    color: {{text_on_accent}};
    border-color: {{accent}};
}

/* Per-class split buttons */
QPushButton#split_btn {
    background: {{bg_hover}};
    color: {{text_muted}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    font-size: 13px;
    padding: 1px 2px;
}
QPushButton#split_btn:hover:!checked { background: {{bg_active}}; }
QPushButton#split_btn:checked {
    background: {{success}};
    color: {{text_on_accent}};
    border-color: {{success}};
    font-weight: 600;
}
QPushButton#split_btn:disabled {
    background: {{bg_raised}};
    color: {{text_faint}};
    border-color: {{border}};
}

/* Current-image assignment summary */
QLabel#seg_state_label {
    color: {{text}};
    font-size: 14px;
    background: {{bg_alt}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 6px;
}

/* Task toggle in the toolbar */
QToolButton:checked {
    background: {{bg_active}};
    border-color: {{accent}};
    color: {{accent_text}};
}

/* ── Duplicate scan dialog ──────────────────────────────────────── */
QTreeWidget#dup_tree {
    background: {{bg_alt}};
    border: 1px solid {{border}};
    outline: none;
    color: {{text}};
    font-size: 15px;
}
QTreeWidget#dup_tree::item {
    padding: 4px 2px;
    border-bottom: 1px solid {{border}};
}
QTreeWidget#dup_tree::item:selected {
    background: {{bg_select}};
    color: {{accent_text}};
}
QTreeWidget#dup_tree QHeaderView::section {
    background: {{bg_alt}};
    color: {{text_muted}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 4px 6px;
    font-size: 14px;
}
QFrame#dup_preview_frame {
    background: {{bg_alt}};
    border: 1px solid {{border}};
    border-radius: 6px;
}
QLabel#dup_preview_tile {
    background: {{bg_deep}};
    border: 1px solid {{border}};
    border-radius: 4px;
    color: {{text_faint}};
}
QLabel#dup_preview_current {
    background: {{bg_deep}};
    border: 2px solid {{accent}};
    border-radius: 4px;
    color: {{text_faint}};
}
QPushButton#dup_reject_btn {
    background: {{danger_soft}};
    color: {{danger}};
    border: 1px solid {{danger}};
    border-radius: 5px;
    font-weight: 600;
}
QPushButton#dup_reject_btn:hover    { background: {{danger_soft}}; }
QPushButton#dup_reject_btn:disabled { color: {{text_faint}}; border-color: {{border_strong}}; background: {{bg_stripe}}; }

/* Destructive toolbar action */
QToolButton#danger_tool_btn { color: {{danger}}; }
QToolButton#danger_tool_btn:hover {
    background: {{danger_soft}};
    border: 1px solid {{danger}};
    border-radius: 5px;
}

/* ── Performance / annotation additions ─────────────────────────── */

/* "Loading…" hint shown while a large image decodes */
QLabel#viewer_hint {
    background: rgba(30, 30, 46, 210);
    color: {{text_muted}};
    border: 1px solid {{border_strong}};
    border-radius: 6px;
    font-size: 13px;
    padding: 6px 14px;
}

/* Live box size / position readout while drawing or dragging */
QLabel#box_readout {
    background: rgba(30, 30, 46, 220);
    color: {{accent_text}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 8px;
}

/* Queue state filter (All / Pending / Done / Flagged) */
QComboBox#queue_filter_combo {
    background: {{bg_hover}};
    color: {{text_muted}};
    border: 1px solid {{border_strong}};
    border-radius: 4px;
    font-size: 12px;
    padding: 1px 6px;
    min-width: 74px;
}
QComboBox#queue_filter_combo:hover { background: {{bg_active}}; }
QComboBox#queue_filter_combo QAbstractItemView {
    background: {{bg}};
    color: {{text}};
    selection-background-color: {{accent}};
    selection-color: {{text_on_accent}};
}

/* Review grid contact sheet */
QListWidget#review_grid {
    background: {{bg_alt}};
    border: 1px solid {{border}};
    border-radius: 6px;
    font-size: 12px;
}
QListWidget#review_grid::item {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
QListWidget#review_grid::item:selected {
    background: {{bg_hover}};
    border-color: {{accent}};
}
